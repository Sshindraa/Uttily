{
  "name": "@uttily/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.integration.test.ts' --exclude 'src/integration/**' --exclude 'src/photos/delete-product-photo.test.ts' --exclude 'src/photos/postgres-publication-gate.test.ts'",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@uttily/contracts": "workspace:*",
    "@uttily/database": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@uttily/config": "workspace:*",
    "postgres": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
