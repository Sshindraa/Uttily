{
  "name": "@uttily/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "CI=1 vitest run",
    "test:fast": "vitest run --exclude 'src/schema-*.test.ts' --exclude 'src/migrate.test.ts'",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:seed:browser": "node scripts/seed-browser-e2e.mjs",
    "db:ensure-browser-e2e-membership": "node scripts/ensure-browser-e2e-membership.mjs",
    "recovery:restore-drill": "node scripts/restore-drill.mjs",
    "test:recovery": "vitest run scripts/restore-drill.test.mjs",
    "benchmark:destination": "node scripts/benchmark-destination-resolution.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
