# Uttily worker — Modèle d'environnement (valeurs FACTICES, versionnable).
#
# Ne JAMAIS mettre de vraies valeurs ici. Ce fichier est versionné dans Git.
# Toutes les valeurs ci-dessous sont manifestement factices.
#
# Le fichier réel sur le VPS futur sera .env.worker, hors Git, avec :
#   - chmod 600
#   - propriétaire dédié (jamais partagé avec sokar/goldbot)
#   - jamais copié dans l'image Docker
#   - rotation manuelle des credentials
#   - ne jamais utiliser `source` si cela risque d'afficher les valeurs
#
# 8 variables requises par createWorkerDependenciesFromEnv (ADR-015 §10b),
# plus les variables de marque utilisées par les emails transactionnels.

DATABASE_URL=postgresql://FAKE_USER:FAKE_PASSWORD@FAKE_HOST:5432/FAKE_DB
PUBLIC_APP_URL=https://FAKE_DOMAIN.example
R2_ACCOUNT_ID=FAKE_ACCOUNT_ID
R2_ACCESS_KEY_ID=FAKE_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=FAKE_SECRET_ACCESS_KEY
R2_BUCKET_NAME=FAKE_BUCKET_NAME
# Le bucket doit être en juridiction EU ; l'endpoint EU est dérivé du compte.
RESEND_API_KEY=re_FAKE_API_KEY
RESEND_FROM_EMAIL=noreply@FAKE_DOMAIN.example
RESEND_BOOKING_CONFIRMED_TEMPLATE_ID=FAKE_TEMPLATE_ID
SUPPORT_EMAIL=support@FAKE_DOMAIN.example
