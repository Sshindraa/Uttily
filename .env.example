# Variables d'environnement Uttily
# Aucune valeur réelle ne doit être commitée. Copier en .env et remplir localement.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Uttily

# Base de données (PostgreSQL + PostGIS)
# Local (Docker Compose optionnel) :
DATABASE_URL=postgresql://uttily:uttily@localhost:5432/uttily
# Neon (staging/production) : fournir via le fournisseur d'hébergement.

# Authentification Clerk (ADR-006)
# Clés à récupérer depuis le dashboard Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optionnel : secret du webhook Clerk (user.created, user.deleted)
CLERK_WEBHOOK_SECRET=

# Hébergement
# Vercel : pas de variable locale requise.
# Neon : DATABASE_URL fournie via Vercel/Neon.
