# Variables d'environnement Uttily
# Aucune valeur réelle ne doit être commitée. Copier en .env et remplir localement.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Uttily

# Pagination de la recherche publique (HMAC-SHA-256, minimum 32 octets).
# Générer un secret distinct par environnement : openssl rand -base64 48
PUBLIC_SEARCH_CURSOR_SECRET=

# Carte publique G7E-B — MapLibre + MapTiler Streets.
# Variable publique injectée par Next.js au build : pour activer la carte,
# la configurer avant `next build` et dans chaque déploiement Web. Elle est
# embarquée dans le bundle navigateur ; ce n'est pas un secret runtime serveur.
# Restreindre la clé par domaine/referrer et quotas dans la configuration MapTiler.
# Aucune clé privée ici.
# Sans cette valeur, la liste de recherche reste utilisable sans carte.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Base de données (PostgreSQL + PostGIS)
# Local (Docker Compose optionnel) :
DATABASE_URL=postgresql://uttily:uttily@127.0.0.1:5432/uttily
# Neon (staging/production) : fournir via le fournisseur d'hébergement.
#
# DATABASE_URL : connexion pooled utilisée par l'application Web et le worker
#   en runtime distant. Côté Neon, l'endpoint pooled contient "-pooler" dans
#   le hostname (ex: ep-xxx-pooler-xxx.region.aws.neon.tech).
#   Les tests unitaires n'utilisent aucune base. Les tests d'intégration
#   PostgreSQL destructifs utilisent uniquement PostgreSQL local (garde-fou
#   assertLocalhost).
#
# DATABASE_DIRECT_URL : connexion directe utilisée UNIQUEMENT par Drizzle Kit
#   pour les migrations et opérations administratives explicites. Côté Neon,
#   l'endpoint direct ne contient PAS "-pooler" (ex: ep-xxx-xxx.region.aws.neon.tech).
#
# Local : les deux peuvent pointer vers localhost (identiques ou non).
# Neon : DATABASE_URL = endpoint pooled, DATABASE_DIRECT_URL = endpoint direct.
# Aucune valeur réelle (hostname, mot de passe, endpoint) ne doit être commitée.
DATABASE_DIRECT_URL=postgresql://uttily:uttily@127.0.0.1:5432/uttily

# Authentification Clerk (ADR-006)
# Clés à récupérer depuis le dashboard Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Secret HMAC des invitations, distinct par environnement (minimum 32 octets).
INVITATION_SECRET=
# Optionnel : secret du webhook Clerk (user.created, user.deleted)
CLERK_WEBHOOK_SECRET=

# Cron — expiration des holds (ADR-009 §18-19), réconciliation des paiements (ADR-010 §12)
# et exécution des compensations (ADR-010 §13).
# Secret partagé pour authentifier les endpoints /api/cron/expire-holds,
# /api/cron/reconcile-payments et /api/cron/process-compensations.
# Vercel Cron envoie ce secret dans le header Authorization: Bearer ${CRON_SECRET}.
# Générer avec : openssl rand -base64 32
CRON_SECRET=

# Stripe — clés et webhooks (ADR-010 §3, §14)
# Clé secrète Stripe (sk_test_... ou sk_live_...). JAMAIS exposée au client.
STRIPE_SECRET_KEY=
# Clé publishable Stripe (pk_test_... ou pk_live_...). Safe à exposer au client
# (variable NEXT_PUBLIC_*). Utilisée par Stripe.js côté navigateur pour le
# Payment Element. Doit correspondre au même environnement que STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Environnement Stripe : TEST ou LIVE (défaut : TEST). Ne pas activer LIVE sans validation finance/juridique.
STRIPE_ENVIRONMENT=TEST
# Secret webhook pour l'endpoint /api/webhooks/stripe/platform (PaymentIntent, Charge, Refund).
# Distinct du secret Connect. Récupéré depuis le dashboard Stripe.
STRIPE_PLATFORM_WEBHOOK_SECRET=
# Secret webhook pour l'endpoint /api/webhooks/stripe/connect (account.updated, capacité du compte).
# Distinct du secret platform. Récupéré depuis le dashboard Stripe.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Allow-list IP des webhooks Stripe (ADR-010 §14). Liste d'IPs séparées par des virgules.
# OBLIGATOIRE en LIVE (fail-closed). En TEST, si non défini, le check est skippé.
# Récupérer les plages IP depuis : https://docs.stripe.com/ips
STRIPE_WEBHOOK_IP_ALLOWLIST=
# Attestation que le rate limiting edge (Vercel Firewall ou équivalent) a été
# configuré et testé. OBLIGATOIRE en LIVE (fail-closed).
# Procédure : configurer Vercel Firewall, tester avec >10 req/s, vérifier 429.
# Voir docs/implementation/stripe-test-setup.md pour détails.
STRIPE_WEBHOOK_RATE_LIMIT_VERIFIED=

# Stripe — activation LIVE (ADR-010 §4). Reste false tant que les 6 verrous
# finance/juridique ne sont pas fermés. Un test ou une valeur par défaut ne peut
# JAMAIS contourner ce verrou.
PAYMENTS_LIVE_ENABLED=false

# Commission plateforme — configuration serveur explicite, en points de base.
# 1000 = 10 %. Même 0 doit être écrit explicitement ; une valeur absente ou
# invalide bloque l'initiation d'un paiement. Une commission LIVE nulle est
# refusée par le serveur.
PLATFORM_COMMISSION_RATE_BPS=1000

# URL canonique reçue par Stripe pour le retour du Payment Element.
# Local : http://localhost:3000 ; staging/production : HTTPS uniquement.
PUBLIC_APP_URL=http://localhost:3000

# Allow-list des origins autorisées pour les liens d'onboarding Stripe (sécurité P2).
# Liste séparée par des virgules. Si vide, l'origin est validée contre le host de la requête.
ALLOWED_ORIGINS=

# Pays supportés pour Stripe Connect (validation côté serveur).
# Liste de codes ISO 3166-1 alpha-2 séparés par des virgules. Si vide, Stripe valide côté provider.
SUPPORTED_STRIPE_COUNTRIES=

# Hébergement
# Vercel : pas de variable locale requise.
# Neon : DATABASE_URL fournie via Vercel/Neon.

# Cloudflare R2 — stockage objet (ADR-014 §2.4, G5H-A)
# Adapter R2 implémenté, testé et câblé au worker (G5H-C2C-B3).
# Aucun credential réel ne doit être commité. Bucket privé, juridiction eu.
# L'adaptateur utilise automatiquement l'endpoint S3 européen
# https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com.
# Variables attendues :
# - R2_ACCOUNT_ID : identifiant de compte Cloudflare (alphanumérique)
# - R2_ACCESS_KEY_ID : clé d'accès R2 (token API R2)
# - R2_SECRET_ACCESS_KEY : secret d'accès R2
# - R2_BUCKET_NAME : nom du bucket R2 (minuscules, 3-63 caractères)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket privé dédié aux photos ; en staging, repli contrôlé sur R2_BUCKET_NAME.
R2_PHOTOS_BUCKET_NAME=

# Resend — email transactionnel (ADR-014 §2.5, G5H-B)
# Adapter Resend implémenté, testé et câblé au worker (G5H-C2C-B3).
# Aucun credential réel ne doit être commité. Aucun domaine configuré.
# Variables attendues :
# - RESEND_API_KEY : clé API Resend (préfixe re_)
# - RESEND_FROM_EMAIL : adresse d'envoi (ex: Uttily <noreply@domaine.com>)
# - RESEND_BOOKING_CONFIRMED_TEMPLATE_ID : identifiant du template Resend
#   pour booking_confirmed_customer
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_BOOKING_CONFIRMED_TEMPLATE_ID=

# Product analytics environment (G7H-B). PRODUCTION remains blocked — no flag can enable it.
PRODUCT_ANALYTICS_ENVIRONMENT=DEVELOPMENT
