# Variables d'environnement Uttily
# Aucune valeur réelle ne doit être commitée. Copier en .env et remplir localement.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Uttily

# Base de données (PostgreSQL + PostGIS)
# Local (Docker Compose optionnel) :
DATABASE_URL=postgresql://uttily:uttily@localhost:5432/uttily
# Neon (staging/production) : fournir via le fournisseur d'hébergement.

# Authentification Clerk (ADR-006)
# Clés à récupérer depuis le dashboard Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optionnel : secret du webhook Clerk (user.created, user.deleted)
CLERK_WEBHOOK_SECRET=

# Cron — expiration des holds (ADR-009 §18-19) et réconciliation des paiements (ADR-010 §12).
# Secret partagé pour authentifier les endpoints /api/cron/expire-holds et /api/cron/reconcile-payments.
# Vercel Cron envoie ce secret dans le header Authorization: Bearer ${CRON_SECRET}.
# Générer avec : openssl rand -base64 32
CRON_SECRET=

# Stripe — clés et webhooks (ADR-010 §3, §14)
# Clé secrète Stripe (sk_test_... ou sk_live_...). JAMAIS exposée au client.
STRIPE_SECRET_KEY=
# Environnement Stripe : TEST ou LIVE (défaut : TEST). Ne pas activer LIVE sans validation finance/juridique.
STRIPE_ENVIRONMENT=TEST
# Secret webhook pour l'endpoint /api/webhooks/stripe/platform (PaymentIntent, Charge, Refund).
# Distinct du secret Connect. Récupéré depuis le dashboard Stripe.
STRIPE_PLATFORM_WEBHOOK_SECRET=
# Secret webhook pour l'endpoint /api/webhooks/stripe/connect (account.updated, capacité du compte).
# Distinct du secret platform. Récupéré depuis le dashboard Stripe.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Allow-list IP des webhooks Stripe (ADR-010 §14). Liste d'IPs séparées par des virgules.
# OBLIGATOIRE en LIVE (fail-closed). En TEST, si non défini, le check est skippé.
# Récupérer les plages IP depuis : https://docs.stripe.com/ips
STRIPE_WEBHOOK_IP_ALLOWLIST=
# Attestation que le rate limiting edge (Vercel Firewall) est configuré et vérifié.
# OBLIGATOIRE en LIVE (fail-closed). Doit être `true` pour activer LIVE.
STRIPE_WEBHOOK_RATE_LIMIT_VERIFIED=

# Hébergement
# Vercel : pas de variable locale requise.
# Neon : DATABASE_URL fournie via Vercel/Neon.
