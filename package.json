{
  "name": "uttily",
  "version": "0.0.0",
  "private": true,
  "description": "Uttily — plateforme B2B2C de location d'équipements.",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:fast",
    "test:fast": "SKIP_INTEGRATION_TESTS=1 SKIP_REPRODUCIBILITY=1 pnpm -r --parallel --workspace-concurrency=6 --if-present run test:fast",
    "test:full": "pnpm -r test",
    "check:fast": "pnpm test:dev-local && pnpm test:fast && pnpm typecheck",
    "build": "pnpm -r build",
    "db:seed": "UTTILY_LOCAL_DEV=1 pnpm --filter @uttily/database db:seed:local",
    "dev": "pnpm --filter web dev",
    "dev:full": "node scripts/dev-local.mjs",
    "test:dev-local": "node --test scripts/dev-local.test.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
